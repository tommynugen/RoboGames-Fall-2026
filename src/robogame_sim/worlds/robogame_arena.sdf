<?xml version="1.0" ?>
<!--
  The Robogame arena, copied from ROBOGAME-2.0/src/arena_sim/worlds and
  tidied so it parses. 1 m square, origin at the centre, X red, Y green.
  Robots are not in this file: sim.launch.py spawns one per robot number.
-->
<sdf version="1.9">
  <world name="robogame_arena">

    <gravity>0 0 -9.81</gravity>

    <physics name="arena_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -1.1 1.0 0 0.75 1.5708</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 0.02</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 0.51 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.04 0.02 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.04 0.02 0.08</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.80 1</ambient>
            <diffuse>0.20 0.35 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -0.51 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.04 0.02 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.04 0.02 0.08</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.80 1</ambient>
            <diffuse>0.20 0.35 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>0.51 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 1.0 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 1.0 0.08</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.80 1</ambient>
            <diffuse>0.20 0.35 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-0.51 0 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.02 1.0 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.02 1.0 0.08</size></box></geometry>
          <material>
            <ambient>0.15 0.25 0.80 1</ambient>
            <diffuse>0.20 0.35 0.90 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="x_axis_marker">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.00 0.005 0.002</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="y_axis_marker">
      <static>true</static>
      <pose>0 0 0.0015 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.005 1.00 0.003</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="origin_marker">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Same spot as the original waypoint_1, moved down onto the floor -->
    <model name="waypoint_1">
      <static>true</static>
      <pose>0.4 0.4 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.035</radius><length>0.004</length></cylinder></geometry>
          <material><ambient>1 0.65 0 1</ambient><diffuse>1 0.65 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="token_1">
      <pose>0.1 0.3 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.00000100</ixx><iyy>0.00000100</iyy><izz>0.00000150</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 1.0 1</ambient>
            <diffuse>0.1 0.2 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="token_2">
      <pose>-0.2 0.25 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.00000100</ixx><iyy>0.00000100</iyy><izz>0.00000150</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 1.0 1</ambient>
            <diffuse>0.1 0.2 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="token_3">
      <pose>0.3 -0.1 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.00000100</ixx><iyy>0.00000100</iyy><izz>0.00000150</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 1.0 1</ambient>
            <diffuse>0.1 0.2 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="token_4">
      <pose>0.0 -0.3 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.00000100</ixx><iyy>0.00000100</iyy><izz>0.00000150</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 1.0 1</ambient>
            <diffuse>0.1 0.2 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="token_5">
      <pose>-0.35 0.0 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.03</mass>
          <inertia>
            <ixx>0.00000100</ixx><iyy>0.00000100</iyy><izz>0.00000150</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.01</radius><length>0.01</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.2 1.0 1</ambient>
            <diffuse>0.1 0.2 1.0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
